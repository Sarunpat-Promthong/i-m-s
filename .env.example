# EN: Copy this file to ".env" and fill in your own values. Never commit .env to Git.
# TH: คัดลอกไฟล์นี้เป็น ".env" แล้วใส่ค่าของคุณเอง ห้าม commit ไฟล์ .env ขึ้น Git

# EN: MongoDB connection string (local or MongoDB Atlas)
# TH: ลิงก์เชื่อมต่อ MongoDB (เครื่องตัวเองหรือ MongoDB Atlas)
CONNECT_STRING=mongodb://127.0.0.1:27017/inventory

# EN: Server port (optional, default 3000) / TH: พอร์ตของเซิร์ฟเวอร์ (ไม่ใส่ก็ได้ ค่าเริ่มต้น 3000)
PORT=3000
